using Gtk 4.0;
using Adw 1;

template $KikoeOptionsGroup: Adw.PreferencesGroup {
  title: _("Options");

  Adw.SwitchRow timestamps_row {
    title: _("_Timestamps");
    use-underline: true;
    notify::active => $_on_option_row_notify_active();
  }

  Adw.SwitchRow speakers_row {
    title: _("_Speakers");
    use-underline: true;
    notify::active => $_on_option_row_notify_active();
  }

  Label language_notice {
    label: _(
      "The transcription language is not used while timestamps or speakers are on. The language is detected automatically."
    );
    wrap: true;
    xalign: 0;
    margin-top: 6;
    visible: false;

    styles [
      "dimmed",
      "caption",
    ]
  }
}
