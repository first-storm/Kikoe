using Gtk 4.0;
using Adw 1;

Adw.ShortcutsDialog shortcuts_dialog {
  Adw.ShortcutsSection {
    title: _("Notes");

    Adw.ShortcutsItem {
      title: _("New Note");
      accelerator: "<Primary>n";
    }

    Adw.ShortcutsItem {
      title: _("Search Notes");
      accelerator: "<Primary>f";
    }

    Adw.ShortcutsItem {
      title: _("Import Audio…");
      accelerator: "<Primary>o";
    }

    Adw.ShortcutsItem {
      title: _("Rename Note…");
      accelerator: "F2";
    }

    Adw.ShortcutsItem {
      title: _("Export Note…");
      accelerator: "<Primary><Shift>e";
    }

    Adw.ShortcutsItem {
      title: _("Close Search");
      accelerator: "Escape";
    }
  }

  Adw.ShortcutsSection {
    title: _("General");

    Adw.ShortcutsItem {
      title: _("Main Menu");
      accelerator: "F10";
    }

    Adw.ShortcutsItem {
      title: _("Preferences");
      accelerator: "<Primary>comma";
    }

    Adw.ShortcutsItem {
      title: _("Keyboard Shortcuts");
      accelerator: "<Primary>question";
    }

    Adw.ShortcutsItem {
      title: _("Close Window");
      accelerator: "<Primary>w";
    }

    Adw.ShortcutsItem {
      title: _("Quit");
      accelerator: "<Primary>q";
    }
  }
}
