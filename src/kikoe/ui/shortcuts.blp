using Gtk 4.0;
using Adw 1;

Adw.ShortcutsDialog shortcuts_dialog {
  Adw.ShortcutsSection {
    title: _("Notes");

    Adw.ShortcutsItem {
      title: _("New Note");
      accelerator: "<Primary>n";
    }

    Adw.ShortcutsItem {
      title: _("Search Notes");
      accelerator: "<Primary>f";
    }

    Adw.ShortcutsItem {
      title: _("Import Audio…");
      accelerator: "<Primary>o";
    }

    Adw.ShortcutsItem {
      title: _("Rename Note…");
      accelerator: "F2";
    }

    Adw.ShortcutsItem {
      title: _("Export Note…");
      accelerator: "<Primary><Shift>e";
    }

    Adw.ShortcutsItem {
      title: _("Close Search");
      accelerator: "Escape";
    }
  }

  Adw.ShortcutsSection {
    title: _("Editing");

    Adw.ShortcutsItem {
      title: _("Undo");
      accelerator: "<Primary>z";
    }

    Adw.ShortcutsItem {
      title: _("Redo");
      accelerator: "<Primary><Shift>z <Primary>y";
    }

    Adw.ShortcutsItem {
      title: _("Find and Replace");
      accelerator: "<Primary>h <Primary><Alt>f";
    }

    Adw.ShortcutsItem {
      title: _("Next Match");
      accelerator: "<Primary>g";
    }

    Adw.ShortcutsItem {
      title: _("Previous Match");
      accelerator: "<Primary><Shift>g";
    }

    Adw.ShortcutsItem {
      title: _("Next Segment");
      accelerator: "Return";
    }

    Adw.ShortcutsItem {
      title: _("New Line in Segment");
      accelerator: "<Shift>Return";
    }

    Adw.ShortcutsItem {
      title: _("Revert Unsaved Typing");
      accelerator: "Escape";
    }
  }

  Adw.ShortcutsSection {
    title: _("General");

    Adw.ShortcutsItem {
      title: _("Main Menu");
      accelerator: "F10";
    }

    Adw.ShortcutsItem {
      title: _("Preferences");
      accelerator: "<Primary>comma";
    }

    Adw.ShortcutsItem {
      title: _("Keyboard Shortcuts");
      accelerator: "<Primary>question";
    }

    Adw.ShortcutsItem {
      title: _("Close Window");
      accelerator: "<Primary>w";
    }

    Adw.ShortcutsItem {
      title: _("Quit");
      accelerator: "<Primary>q";
    }
  }
}
