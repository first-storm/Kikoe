using Gtk 4.0;
using Adw 1;

template $KikoeWindow: Adw.ApplicationWindow {
  title: _("Kikoe");
  default-width: 1180;
  default-height: 780;
  width-request: 360;
  height-request: 294;
  close-request => $_on_window_close_request();

  Adw.Breakpoint {
    condition ("max-width: 640sp")

    setters {
      split_view.collapsed: true;
    }
  }

  // Not redundant with the breakpoint above: libadwaita checks each breakpoint on its own
  // when computing the minimum width, so this one must collapse the split view as well.
  Adw.Breakpoint {
    condition ("max-width: 480sp")

    setters {
      split_view.collapsed: true;
      content_header.decoration-layout: ":close";
    }
  }

  content: Adw.ToastOverlay toast_overlay {
    child: Adw.NavigationSplitView split_view {
      min-sidebar-width: 220;
      max-sidebar-width: 260;

      sidebar: Adw.NavigationPage {
        title: _("Kikoe");

        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {
            [start]
            Button {
              icon-name: "list-add-symbolic";
              tooltip-text: _("New Note");

              accessibility {
                label: _("New Note");
              }

              action-name: "win.new-note";
            }

            [end]
            MenuButton {
              primary: true;
              icon-name: "open-menu-symbolic";
              tooltip-text: _("Main Menu");

              accessibility {
                label: _("Main Menu");
              }

              menu-model: primary_menu;
            }

            [end]
            ToggleButton search_button {
              icon-name: "system-search-symbolic";
              tooltip-text: _("Search Notes");
              active: bind search_bar.search-mode-enabled bidirectional;

              accessibility {
                label: _("Search Notes");
              }
            }
          }

          [top]
          SearchBar search_bar {
            notify::search-mode-enabled => $_on_search_bar_notify_search_mode_enabled();

            child: SearchEntry search_entry {
              placeholder-text: _("Search Notes");
              hexpand: true;
              search-delay: 200;
              search-changed => $_on_search_entry_search_changed();
              stop-search => $_on_search_entry_stop_search();
            };
          }

          content: ScrolledWindow {
            hscrollbar-policy: never;

            child: ListBox notes_list {
              vexpand: true;
              row-selected => $_on_notes_list_row_selected();

              styles [
                "navigation-sidebar",
              ]

              [placeholder]
              Adw.StatusPage notes_placeholder {
                icon-name: "document-edit-symbolic";
                title: _("No Notes Yet");
                valign: center;

                styles [
                  "compact",
                ]
              }
            };
          };
        };
      };

      content: Adw.NavigationPage content_page {
        title: _("Kikoe");

        child: Adw.ToolbarView {
          bottom-bar-style: raised_border;

          styles [
            "view",
          ]

          [top]
          Adw.HeaderBar content_header {
            title-widget: Adw.WindowTitle window_title {
              title: _("Kikoe");
            };

            [start]
            Button undo_button {
              icon-name: "edit-undo-symbolic";
              tooltip-text: _("Undo");
              action-name: "win.undo";
              visible: bind note_menu_button.visible;

              accessibility {
                label: _("Undo");
              }
            }

            [start]
            Button redo_button {
              icon-name: "edit-redo-symbolic";
              tooltip-text: _("Redo");
              action-name: "win.redo";
              visible: bind note_menu_button.visible;

              accessibility {
                label: _("Redo");
              }
            }

            [end]
            MenuButton note_menu_button {
              icon-name: "view-more-symbolic";
              tooltip-text: _("Note Menu");

              accessibility {
                label: _("Note Menu");
              }

              menu-model: note_menu;
              visible: false;
            }

            [end]
            MenuButton display_options_button {
              icon-name: "view-reveal-symbolic";
              always-show-arrow: true;
              tooltip-text: _("Display Options");

              accessibility {
                label: _("Display Options");
              }

              visible: false;
              menu-model: display_menu;
            }
          }

          content: Stack content_stack {
            hhomogeneous: false;

            StackPage {
              name: "loading";

              child: Box {};
            }

            StackPage {
              name: "empty";

              child: Adw.StatusPage {
                icon-name: "document-edit-symbolic";
                title: _("No Note Selected");
                description: _("Create a note, then record or import audio into it.");

                child: Button {
                  label: _("_New Note");
                  use-underline: true;
                  halign: center;
                  action-name: "win.new-note";

                  styles [
                    "pill",
                    "suggested-action",
                  ]
                };
              };
            }

            StackPage {
              name: "welcome";

              child: Adw.StatusPage {
                icon-name: "io.github.first_storm.Kikoe";
                title: _("Welcome to Kikoe");
                description: _(
                  "Kikoe turns speech into text using cloud services. Add a provider and a model first, then record or import audio."
                );

                child: Button {
                  label: _("_Add Provider");
                  use-underline: true;
                  halign: center;
                  action-name: "app.add-provider";

                  styles [
                    "pill",
                    "suggested-action",
                  ]
                };
              };
            }

            StackPage {
              name: "note";

              child: Adw.Bin note_view_slot {};
            }
          };

          [bottom]
          Adw.Bin bottom_bar_slot {
            visible: false;
          }
        };
      };
    };
  };
}

menu primary_menu {
  section {
    item {
      label: _("_Import Audio…");
      action: "win.import-audio";
    }
  }

  section {
    item {
      label: _("_Preferences");
      action: "app.preferences";
    }

    item {
      label: _("_Keyboard Shortcuts");
      action: "app.shortcuts";
    }

    item {
      label: _("_About Kikoe");
      action: "app.about";
    }
  }
}

menu display_menu {
  section {
    item {
      label: _("Show _Timestamps");
      action: "win.show-timestamps";
    }

    item {
      label: _("Show _Speakers");
      action: "win.show-speakers";
    }
  }
}

menu note_menu {
  section {
    item {
      label: _("_Rename…");
      action: "win.rename-note";
    }

    item {
      label: _("_Copy All Text");
      action: "win.copy-all-text";
    }

    item {
      label: _("_Export…");
      action: "win.export";
    }
  }

  section {
    item {
      label: _("_Delete Note");
      action: "win.delete-note";
    }
  }
}
