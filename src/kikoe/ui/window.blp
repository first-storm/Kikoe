using Gtk 4.0;
using Adw 1;

template $KikoeWindow: Adw.ApplicationWindow {
  title: _("Kikoe");
  default-width: 1180;
  default-height: 780;
  width-request: 360;
  height-request: 294;
  close-request => $_on_window_close_request();

  Adw.Breakpoint {
    condition ("max-width: 640sp")

    setters {
      split_view.collapsed: true;
    }
  }

  Adw.Breakpoint {
    condition ("max-width: 480sp")

    setters {
      split_view.collapsed: true;
      content_header.decoration-layout: ":close";
    }
  }

  content: Adw.ToastOverlay toast_overlay {
    child: Adw.NavigationSplitView split_view {
      sidebar: Adw.NavigationPage {
        title: _("Kikoe");

        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {
            [start]
            Button {
              icon-name: "list-add-symbolic";
              tooltip-text: _("New Note");
              action-name: "win.new-note";
            }

            [end]
            MenuButton {
              primary: true;
              icon-name: "open-menu-symbolic";
              tooltip-text: _("Main Menu");
              menu-model: primary_menu;
            }
          }

          content: ScrolledWindow {
            hscrollbar-policy: never;

            child: ListBox notes_list {
              vexpand: true;
              row-selected => $_on_notes_list_row_selected();

              styles [
                "navigation-sidebar",
              ]

              [placeholder]
              Label {
                label: _("No Notes Yet");
                valign: center;

                styles [
                  "dim-label",
                ]
              }
            };
          };
        };
      };

      content: Adw.NavigationPage content_page {
        title: _("Kikoe");

        child: Adw.ToolbarView {
          bottom-bar-style: raised_border;

          styles [
            "view",
          ]

          [top]
          Adw.HeaderBar content_header {
            title-widget: Adw.WindowTitle window_title {
              title: _("Kikoe");
            };

            [end]
            MenuButton note_menu_button {
              icon-name: "view-more-symbolic";
              tooltip-text: _("Note Menu");
              menu-model: note_menu;
              visible: false;
            }

            [end]
            MenuButton export_button {
              icon-name: "document-send-symbolic";
              tooltip-text: _("Export");
              visible: false;

              popover: Popover export_popover {
                child: Box {
                  orientation: vertical;
                  spacing: 2;
                  width-request: 280;

                  Button {
                    action-name: "win.export-txt";

                    styles [
                      "flat",
                    ]

                    child: Label {
                      label: _("Plain Text (.txt)");
                      xalign: 0;
                      hexpand: true;
                    };
                  }

                  Button {
                    action-name: "win.export-md";

                    styles [
                      "flat",
                    ]

                    child: Label {
                      label: _("Markdown (.md)");
                      xalign: 0;
                      hexpand: true;
                    };
                  }

                  Button export_srt_button {
                    action-name: "win.export-srt";

                    styles [
                      "flat",
                    ]

                    child: Label {
                      label: _("SRT Subtitles (.srt)");
                      xalign: 0;
                      hexpand: true;
                    };
                  }

                  Button export_vtt_button {
                    action-name: "win.export-vtt";

                    styles [
                      "flat",
                    ]

                    child: Label {
                      label: _("WebVTT Subtitles (.vtt)");
                      xalign: 0;
                      hexpand: true;
                    };
                  }

                  Separator {}

                  Label {
                    label: _(
                      "Speaker labels follow the current display settings. Subtitle formats always include timestamps."
                    );
                    wrap: true;
                    max-width-chars: 36;
                    xalign: 0;
                    margin-start: 12;
                    margin-end: 12;
                    margin-bottom: 6;

                    styles [
                      "caption",
                      "dim-label",
                    ]
                  }
                };
              };
            }

            [end]
            MenuButton display_options_button {
              icon-name: "view-reveal-symbolic";
              always-show-arrow: true;
              tooltip-text: _("Display Options");
              visible: false;

              popover: Popover {
                child: Box {
                  orientation: vertical;
                  spacing: 6;
                  width-request: 280;

                  ListBox {
                    selection-mode: none;

                    styles [
                      "navigation-sidebar",
                    ]

                    Adw.SwitchRow timestamps_row {
                      title: _("Show _Timestamps");
                      use-underline: true;
                      notify::active => $_on_display_row_notify_active();
                    }

                    Adw.SwitchRow speakers_row {
                      title: _("Show _Speakers");
                      use-underline: true;
                      notify::active => $_on_display_row_notify_active();
                    }
                  }

                  Label {
                    label: _("Only changes how this note is shown and exported. The transcript is not modified.");
                    wrap: true;
                    max-width-chars: 36;
                    xalign: 0;
                    margin-start: 12;
                    margin-end: 12;
                    margin-bottom: 6;

                    styles [
                      "caption",
                      "dim-label",
                    ]
                  }
                };
              };
            }
          }

          content: Stack content_stack {
            hhomogeneous: false;

            StackPage {
              name: "loading";

              child: Box {};
            }

            StackPage {
              name: "empty";

              child: Adw.StatusPage {
                icon-name: "io.github.first_storm.Kikoe";
                title: _("No Note Selected");
                description: _("Record or import audio to create a note.");
              };
            }

            StackPage {
              name: "welcome";

              child: Adw.StatusPage {
                icon-name: "io.github.first_storm.Kikoe";
                title: _("Welcome to Kikoe");
                description: _(
                  "Kikoe turns speech into text using cloud services. Add a provider and a model first, then record or import audio."
                );

                child: Button {
                  label: _("_Add Provider");
                  use-underline: true;
                  halign: center;
                  action-name: "app.add-provider";

                  styles [
                    "pill",
                    "suggested-action",
                  ]
                };
              };
            }

            StackPage {
              name: "note";

              child: Adw.Bin note_view_slot {};
            }
          };

          [bottom]
          Adw.Bin bottom_bar_slot {
            visible: false;
          }
        };
      };
    };
  };
}

menu primary_menu {
  section {
    item {
      label: _("_Preferences");
      action: "app.preferences";
    }

    item {
      label: _("_About Kikoe");
      action: "app.about";
    }
  }
}

menu note_menu {
  section {
    item {
      label: _("_Rename…");
      action: "win.rename-note";
    }

    item {
      label: _("_Copy All Text");
      action: "win.copy-all-text";
    }
  }

  section {
    item {
      label: _("_Delete Note");
      action: "win.delete-note";
    }
  }
}
