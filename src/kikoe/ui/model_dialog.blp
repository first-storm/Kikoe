using Gtk 4.0;
using Adw 1;

template $KikoeModelDialog: Adw.Dialog {
  title: _("Add Model");
  content-width: 480;
  content-height: 600;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-start-title-buttons: false;
      show-end-title-buttons: false;

      [start]
      Button {
        label: _("_Cancel");
        use-underline: true;
        clicked => $_on_cancel_button_clicked();
      }

      [end]
      Button confirm_button {
        label: _("_Add");
        use-underline: true;
        clicked => $_on_confirm_button_clicked();

        styles [
          "suggested-action",
        ]
      }
    }

    content: Adw.PreferencesPage {
      Adw.PreferencesGroup {
        Adw.EntryRow model_id_row {
          changed => $_on_model_id_row_changed();
          title: _("Model ID");
        }

        Adw.EntryRow display_name_row {
          title: _("Display Name");
        }

        Label error_label {
          visible: false;
          wrap: true;
          xalign: 0;
          margin-top: 6;

          styles [
            "error",
          ]
        }
      }

      Adw.PreferencesGroup {
        title: _("What This Model Supports");
        description: _(
          "Known models are filled in automatically. Options the provider rejects for this model are unavailable."
        );

        Adw.ExpanderRow file_row {
          title: _("Transcribe _Files");
          subtitle: _("Imported files, and recordings uploaded after they stop.");
          use-underline: true;
          show-enable-switch: true;
          notify::enable-expansion => $_on_option_changed();

          Adw.ActionRow {
            title: _("Timestamps");
            subtitle: _("Each segment carries a time. Needed for subtitle export.");
            activatable-widget: file_timestamps_check;

            [prefix]
            CheckButton file_timestamps_check {
              valign: center;
              notify::active => $_on_option_changed();
            }
          }

          Adw.ActionRow {
            title: _("Word Timestamps");
            subtitle: _("Times can be requested for single words.");
            activatable-widget: file_words_check;

            [prefix]
            CheckButton file_words_check {
              valign: center;
              notify::active => $_on_option_changed();
            }
          }

          Adw.ActionRow {
            title: _("Speaker Detection");
            subtitle: _("Tells different people apart and labels them.");
            activatable-widget: file_speakers_check;

            [prefix]
            CheckButton file_speakers_check {
              valign: center;
              notify::active => $_on_option_changed();
            }
          }

          Adw.ActionRow {
            title: _("Streaming Preview");
            subtitle: _("Text appears while a file is transcribed.");
            activatable-widget: file_streaming_check;

            [prefix]
            CheckButton file_streaming_check {
              valign: center;
              notify::active => $_on_option_changed();
            }
          }
        }

        Adw.ExpanderRow realtime_row {
          title: _("Transcribe While _Recording");
          subtitle: _("Text appears while recording. If off, the whole recording is uploaded after it stops.");
          use-underline: true;
          show-enable-switch: true;
          notify::enable-expansion => $_on_option_changed();

          Adw.ActionRow {
            title: _("Timestamps");
            activatable-widget: realtime_timestamps_check;

            [prefix]
            CheckButton realtime_timestamps_check {
              valign: center;
              notify::active => $_on_option_changed();
            }
          }

          Adw.ActionRow {
            title: _("Speaker Detection");
            activatable-widget: realtime_speakers_check;

            [prefix]
            CheckButton realtime_speakers_check {
              valign: center;
              notify::active => $_on_option_changed();
            }
          }
        }
      }

      Adw.PreferencesGroup remove_group {
        visible: false;

        Adw.ButtonRow {
          title: _("_Remove Model");
          use-underline: true;
          activated => $_on_remove_row_activated();

          styles [
            "destructive-action",
          ]
        }
      }
    };
  };
}
