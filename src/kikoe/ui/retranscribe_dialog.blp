using Gtk 4.0;
using Adw 1;

template $KikoeRetranscribeDialog: Adw.Dialog {
  title: _("Re-transcribe");
  content-width: 480;
  content-height: 520;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-start-title-buttons: false;
      show-end-title-buttons: false;

      [start]
      Button {
        label: _("_Cancel");
        use-underline: true;
        clicked => $_on_cancel_button_clicked();
      }

      [end]
      Button transcribe_button {
        label: _("_Transcribe");
        use-underline: true;
        clicked => $_on_transcribe_button_clicked();

        styles [
          "suggested-action",
        ]
      }
    }

    content: ScrolledWindow {
      hscrollbar-policy: never;

      child: Box {
        orientation: vertical;
        spacing: 16;
        margin-top: 12;
        margin-start: 24;
        margin-end: 24;
        margin-bottom: 24;

        Label intro_label {
          xalign: 0;
          wrap: true;

          styles [
            "dim-label",
          ]
        }

        ListBox {
          selection-mode: none;

          styles [
            "boxed-list",
          ]

          Adw.ActionRow {
            title: _("Model");

            [suffix]
            MenuButton model_button {
              valign: center;

              child: Box {
                spacing: 8;

                Label model_label {
                  ellipsize: end;
                  max-width-chars: 20;

                  styles [
                    "dim-label",
                  ]
                }

                Image {
                  icon-name: "pan-down-symbolic";
                }
              };

              popover: Popover model_popover {
                child: ScrolledWindow {
                  hscrollbar-policy: never;
                  max-content-height: 280;
                  propagate-natural-height: true;

                  child: ListBox models_list {
                    selection-mode: none;

                    styles [
                      "navigation-sidebar",
                    ]
                  };
                };
              };
            }
          }

          Adw.SwitchRow timestamps_row {
            title: _("Timestamps");
          }

          Adw.SwitchRow speakers_row {
            title: _("Speaker Detection");
          }
        }

        Box {
          spacing: 10;
          margin-top: 4;

          styles [
            "retranscription-warning",
          ]

          Image {
            icon-name: "dialog-warning-symbolic";
            valign: start;

            styles [
              "warning",
            ]
          }

          Label {
            label: _(
              "The text of this recording will be replaced, including any manual edits. Other recordings in the note are not affected. Speaker names are kept where possible."
            );
            xalign: 0;
            wrap: true;
            hexpand: true;

            styles [
              "caption",
            ]
          }
        }
      };
    };
  };
}
