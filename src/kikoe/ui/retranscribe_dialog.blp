using Gtk 4.0;
using Adw 1;

template $KikoeRetranscribeDialog: Adw.Dialog {
  title: _("Re-transcribe");
  content-width: 480;
  content-height: 520;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-start-title-buttons: false;
      show-end-title-buttons: false;

      [start]
      Button {
        label: _("_Cancel");
        use-underline: true;
        clicked => $_on_cancel_button_clicked();
      }

      [end]
      Button transcribe_button {
        label: _("_Transcribe");
        use-underline: true;
        clicked => $_on_transcribe_button_clicked();

        styles [
          "destructive-action",
        ]
      }
    }

    content: Adw.PreferencesPage {
      Adw.PreferencesGroup intro_group {
        Adw.ComboRow model_row {
          title: _("Model");
          use-markup: false;
          notify::selected => $_on_model_row_notify_selected();
        }

        Adw.SwitchRow timestamps_row {
          title: _("Timestamps");
        }

        Adw.SwitchRow segment_row {
          title: _("Segment Timestamps");
          notify::active => $_on_granularity_row_toggled();
        }

        Adw.SwitchRow word_row {
          title: _("Word Timestamps");
          notify::active => $_on_granularity_row_toggled();
        }

        Adw.SwitchRow speakers_row {
          title: _("Speaker Detection");
        }
      }

      Adw.PreferencesGroup {
        Adw.ActionRow {
          title: _("Existing Text Is Replaced");
          subtitle: _(
            "The text of this recording will be replaced, including any manual edits. Other recordings in the note are not affected. Speaker names are kept where possible."
          );
          subtitle-lines: 0;

          [prefix]
          Image {
            icon-name: "dialog-warning-symbolic";
            valign: center;

            styles [
              "warning",
            ]
          }
        }
      }
    };
  };
}
