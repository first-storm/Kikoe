using Gtk 4.0;
using Adw 1;

template $KikoeRetranscribeDialog: Adw.Dialog {
  title: _("Re-transcribe");
  content-width: 480;
  content-height: 560;

  child: Adw.NavigationView navigation_view {
    popped => $_on_navigation_view_popped();

    Adw.NavigationPage {
      title: _("Re-transcribe");
      tag: "main";

      child: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {
          show-start-title-buttons: false;
          show-end-title-buttons: false;

          [start]
          Button {
            label: _("_Cancel");
            use-underline: true;
            clicked => $_on_cancel_button_clicked();
          }

          [end]
          Button transcribe_button {
            label: _("_Transcribe");
            use-underline: true;
            clicked => $_on_transcribe_button_clicked();

            styles [
              "destructive-action",
            ]
          }
        }

        content: Adw.PreferencesPage {
          Adw.PreferencesGroup intro_group {}

          Adw.PreferencesGroup {
            title: _("Model");

            Adw.ActionRow model_row {
              use-markup: false;
              activatable: true;
              activated => $_on_model_row_activated();

              [suffix]
              Image {
                icon-name: "go-next-symbolic";
                accessible-role: presentation;
              }
            }
          }

          Adw.PreferencesGroup {
            Box options_slot {
              orientation: vertical;
            }
          }

          Adw.PreferencesGroup {
            Adw.ActionRow {
              title: _("Existing Text Is Replaced");
              subtitle: _(
                "The text of this recording will be replaced, including any manual edits. Other recordings in the note are not affected. Speaker names are kept where possible."
              );
              subtitle-lines: 0;

              [prefix]
              Image {
                icon-name: "dialog-warning-symbolic";
                valign: center;

                styles [
                  "warning",
                ]
              }
            }
          }
        };
      };
    }
  };
}
