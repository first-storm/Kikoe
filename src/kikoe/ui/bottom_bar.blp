using Gtk 4.0;
using Adw 1;

template $KikoeBottomBar: Adw.Bin {
  child: Adw.BreakpointBin {
    width-request: 360;
    height-request: 1;

    Adw.Breakpoint {
      condition ("max-width: 600sp")

      setters {
        provider_label.visible: false;
        import_label.visible: false;
        recording_summary.visible: false;
      }
    }

    // Only one breakpoint applies at a time, so the narrower one repeats the wider one's setters.
    Adw.Breakpoint {
      condition ("max-width: 480sp")

      setters {
        provider_label.visible: false;
        import_label.visible: false;
        recording_summary.visible: false;
        meter_slot.visible: false;
        model_arrow.visible: false;
        model_label.max-width-chars: 12;
      }
    }

    child: Stack state_stack {
      hhomogeneous: false;
      vhomogeneous: true;
      transition-type: crossfade;
      transition-duration: 150;

      StackPage {
        name: "idle";

        child: Box {
          Button model_button {
            action-name: "win.choose-model";
            can-shrink: true;
            tooltip-text: _("Transcription Model…");

            accessibility {
              label: _("Transcription Model");
            }

            child: Box {
              spacing: 6;

              Image model_icon {
                icon-name: "network-server-symbolic";
              }

              Label model_label {
                ellipsize: end;
                max-width-chars: 20;

                styles [
                  "heading",
                ]
              }

              Label provider_label {
                ellipsize: end;
                max-width-chars: 14;

                styles [
                  "caption",
                  "dimmed",
                ]
              }

              Image model_arrow {
                icon-name: "pan-down-symbolic";

                styles [
                  "dimmed",
                ]
              }
            };

            styles [
              "flat",
            ]
          }

          Box {
            hexpand: true;
          }

          Box {
            spacing: 6;

            Button import_button {
              action-name: "win.import-audio";
              tooltip-text: _("Import Audio…");

              accessibility {
                label: _("Import Audio");
              }

              child: Box {
                spacing: 6;

                Image {
                  icon-name: "folder-open-symbolic";
                }

                Label import_label {
                  label: _("_Import Audio…");
                  use-underline: true;
                  mnemonic-widget: import_button;
                }
              };

              styles [
                "flat",
              ]
            }

            Button record_button {
              action-name: "win.start-recording";

              styles [
                "suggested-action",
              ]

              child: Adw.ButtonContent record_content {
                icon-name: "audio-input-microphone-symbolic";
                label: _("_Record");
                use-underline: true;
              };
            }
          }

          styles [
            "toolbar",
          ]
        };
      }

      StackPage {
        name: "progress";

        child: Box {
          Box {
            spacing: 12;
            hexpand: true;
            margin-start: 6;

            Adw.Spinner {
              width-request: 16;
              height-request: 16;
              valign: center;
            }

            Label progress_label {
              hexpand: true;
              xalign: 0;
              ellipsize: end;
            }
          }

          Box {
            spacing: 6;

            Button cancel_button {
              label: _("_Cancel");
              use-underline: true;
              action-name: "win.cancel-import";

              styles [
                "flat",
              ]
            }
          }

          styles [
            "toolbar",
          ]
        };
      }

      StackPage {
        name: "recording";

        child: Box {
          Box {
            spacing: 8;
            margin-start: 6;
            valign: center;

            Image recording_dot {
              icon-name: "media-record-symbolic";
              pixel-size: 10;
              valign: center;

              styles [
                "recording-indicator",
              ]
            }

            Label elapsed_label {
              label: "00:00";

              styles [
                "title-4",
                "numeric",
              ]
            }

            Label paused_label {
              label: _("Paused");
              visible: false;

              styles [
                "caption-heading",
                "dimmed",
              ]
            }
          }

          Adw.Bin meter_slot {
            margin-start: 6;
          }

          Box {
            spacing: 8;
            hexpand: true;
            margin-start: 6;

            Adw.Spinner connection_spinner {
              visible: false;
              width-request: 16;
              height-request: 16;
              valign: center;
              tooltip-text: _("Preparing transcription…");

              accessibility {
                label: _("Transcription in progress");
              }
            }

            Label recording_summary {
              xalign: 0;
              ellipsize: end;

              styles [
                "caption",
                "dimmed",
              ]
            }
          }

          Box {
            spacing: 6;

            Button pause_button {
              icon-name: "media-playback-pause-symbolic";
              tooltip-text: _("Pause Recording");
              action-name: "win.pause-recording";
              valign: center;

              accessibility {
                label: _("Pause Recording");
              }

              styles [
                "circular",
                "flat",
              ]
            }

            Button stop_button {
              action-name: "win.stop-recording";

              styles [
                "suggested-action",
              ]

              child: Adw.ButtonContent {
                icon-name: "media-playback-stop-symbolic";
                label: _("_Stop");
                use-underline: true;
              };
            }
          }

          styles [
            "toolbar",
          ]
        };
      }
    };
  };
}
