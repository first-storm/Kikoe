using Gtk 4.0;
using Adw 1;

template $KikoeBottomBar: Adw.Bin {
  child: Adw.BreakpointBin {
    width-request: 360;
    height-request: 1;

    Adw.Breakpoint {
      condition ("max-width: 600sp")

      setters {
        provider_label.visible: false;
        import_label.visible: false;
        recording_summary.visible: false;
      }
    }

    Adw.Breakpoint {
      condition ("max-width: 480sp")

      setters {
        provider_label.visible: false;
        import_label.visible: false;
        recording_summary.visible: false;
        meter_slot.visible: false;
      }
    }

    child: Stack state_stack {
      hhomogeneous: false;
      vhomogeneous: true;

      StackPage {
        name: "idle";

        child: Box {
          Button model_button {
            action-name: "win.choose-model";
            can-shrink: true;
            tooltip-text: _("Transcription Model…");

            accessibility {
              label: _("Transcription Model");
            }

            child: Box {
              spacing: 8;

              Image {
                icon-name: "network-server-symbolic";
              }

              Label model_label {
                ellipsize: end;
                max-width-chars: 20;

                styles [
                  "heading",
                ]
              }

              Label provider_label {
                ellipsize: end;
                max-width-chars: 14;

                styles [
                  "caption",
                  "dimmed",
                ]
              }
            };

            styles [
              "flat",
            ]
          }

          Box {
            hexpand: true;
          }

          Button import_button {
            action-name: "win.import-audio";
            tooltip-text: _("Import Audio…");

            accessibility {
              label: _("Import Audio");
            }

            child: Box {
              spacing: 6;

              Image {
                icon-name: "folder-open-symbolic";
              }

              Label import_label {
                label: _("_Import Audio…");
                use-underline: true;
                mnemonic-widget: import_button;
              }
            };

            styles [
              "flat",
            ]
          }

          Button record_button {
            action-name: "win.start-recording";

            styles [
              "suggested-action",
            ]

            child: Adw.ButtonContent record_content {
              icon-name: "audio-input-microphone-symbolic";
              label: _("_Record");
              use-underline: true;
            };
          }

          styles [
            "toolbar",
          ]
        };
      }

      StackPage {
        name: "progress";

        child: Box {
          spacing: 9;

          Adw.Spinner {
            margin-start: 6;
          }

          Label progress_label {
            hexpand: true;
            xalign: 0;
            ellipsize: end;
          }

          Button cancel_button {
            label: _("_Cancel");
            use-underline: true;
            action-name: "win.cancel-import";
          }

          styles [
            "toolbar",
          ]
        };
      }

      StackPage {
        name: "recording";

        child: Box {
          spacing: 12;

          Box {
            spacing: 12;
            margin-start: 6;

            Image recording_dot {
              icon-name: "media-record-symbolic";
              pixel-size: 10;

              styles [
                "recording-indicator",
              ]
            }

            Label elapsed_label {
              label: "00:00";

              styles [
                "numeric",
                "recording-time",
              ]
            }
          }

          Adw.Bin meter_slot {}

          Label recording_summary {
            hexpand: true;
            xalign: 0;
            ellipsize: end;
            max-width-chars: 38;

            styles [
              "caption",
              "dimmed",
            ]
          }

          Box {
            hexpand: true;
            visible: bind recording_summary.visible inverted;
          }

          Button pause_button {
            icon-name: "media-playback-pause-symbolic";
            tooltip-text: _("Pause Recording");
            action-name: "win.pause-recording";

            accessibility {
              label: _("Pause Recording");
            }

            styles [
              "circular",
            ]
          }

          Button stop_button {
            action-name: "win.stop-recording";

            styles [
              "suggested-action",
            ]

            child: Adw.ButtonContent {
              icon-name: "media-playback-stop-symbolic";
              label: _("_Stop");
              use-underline: true;
            };
          }

          styles [
            "toolbar",
          ]
        };
      }
    };
  };
}
