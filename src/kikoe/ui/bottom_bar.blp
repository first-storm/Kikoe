using Gtk 4.0;
using Adw 1;

template $KikoeBottomBar: Adw.Bin {
  child: Box {
    spacing: 8;
    margin-top: 8;
    margin-bottom: 8;
    margin-start: 12;
    margin-end: 12;

    MenuButton model_button {
      tooltip-text: _("Transcription Model");

      child: Box {
        spacing: 8;

        Image {
          icon-name: "weather-overcast-symbolic";
        }

        Label model_label {
          ellipsize: end;
          max-width-chars: 20;

          styles [
            "heading",
          ]
        }

        Label provider_label {
          ellipsize: end;
          max-width-chars: 14;

          styles [
            "caption",
            "dim-label",
          ]
        }

        Image {
          icon-name: "pan-down-symbolic";
        }
      };

      popover: Popover model_popover {
        child: Box {
          orientation: vertical;
          spacing: 6;

          ScrolledWindow {
            hscrollbar-policy: never;
            propagate-natural-height: true;
            max-content-height: 360;

            child: ListBox model_list {
              selection-mode: none;
              row-activated => $_on_model_list_row_activated();

              styles [
                "navigation-sidebar",
              ]
            };
          }

          Separator {}

          Button {
            label: _("_Manage Providers and Models…");
            use-underline: true;
            action-name: "app.preferences";

            styles [
              "flat",
            ]
          }
        };
      };
    }

    ToggleButton timestamps_chip {
      toggled => $_on_chip_toggled();

      child: Adw.ButtonContent {
        icon-name: "document-open-recent-symbolic";
        label: _("_Timestamps");
        use-underline: true;
        can-shrink: true;
      };

      styles [
        "feature-chip",
      ]
    }

    ToggleButton speakers_chip {
      toggled => $_on_chip_toggled();

      child: Adw.ButtonContent {
        icon-name: "system-users-symbolic";
        label: _("_Speakers");
        use-underline: true;
        can-shrink: true;
      };

      styles [
        "feature-chip",
      ]
    }

    Label hint_label {
      margin-start: 4;
      hexpand: true;
      xalign: 0;
      ellipsize: end;

      styles [
        "caption",
        "dim-label",
      ]
    }

    Box progress_box {
      spacing: 9;
      hexpand: true;
      visible: false;

      Adw.Spinner {}

      Label progress_label {
        ellipsize: end;
      }
    }

    Button import_button {
      action-name: "win.import-audio";

      child: Adw.ButtonContent {
        icon-name: "folder-open-symbolic";
        label: _("_Import Audio…");
        use-underline: true;
        can-shrink: true;
      };

      styles [
        "flat",
      ]
    }

    Button cancel_button {
      label: _("_Cancel");
      use-underline: true;
      visible: false;
      action-name: "win.cancel-import";
    }
  };
}
