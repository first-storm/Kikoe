using Gtk 4.0;
using Adw 1;

template $KikoeBottomBar: Adw.Bin {
  child: Adw.BreakpointBin {
    width-request: 360;
    height-request: 1;

    Adw.Breakpoint {
      condition ("max-width: 600sp")

      setters {
        provider_label.visible: false;
        import_label.visible: false;
        recording_summary.visible: false;
      }
    }

    Adw.Breakpoint {
      condition ("max-width: 480sp")

      setters {
        provider_label.visible: false;
        import_label.visible: false;
        recording_summary.visible: false;
        meter_slot.visible: false;
      }
    }

    child: Stack state_stack {
      hhomogeneous: false;
      vhomogeneous: true;

      StackPage {
        name: "idle";

        child: Box {
          MenuButton model_button {
            can-shrink: true;
            tooltip-text: _("Transcription Model");

            accessibility {
              label: _("Transcription Model");
            }

            child: Box {
              spacing: 8;

              Image {
                icon-name: "weather-overcast-symbolic";
              }

              Label model_label {
                ellipsize: end;
                max-width-chars: 20;

                styles [
                  "heading",
                ]
              }

              Label provider_label {
                ellipsize: end;
                max-width-chars: 14;

                styles [
                  "caption",
                  "dim-label",
                ]
              }

              Image {
                icon-name: "pan-down-symbolic";
              }
            };

            styles [
              "flat",
            ]

            popover: Popover model_popover {
              child: Box {
                orientation: vertical;
                spacing: 6;

                ScrolledWindow {
                  hscrollbar-policy: never;
                  propagate-natural-height: true;
                  max-content-height: 360;

                  child: ListBox model_list {
                    selection-mode: none;
                    row-activated => $_on_model_list_row_activated();

                    styles [
                      "navigation-sidebar",
                    ]
                  };
                }

                Box options_box {
                  orientation: vertical;
                  spacing: 6;

                  Separator {}

                  Label {
                    label: _("Options");
                    xalign: 0;
                    margin-start: 6;
                    margin-top: 6;

                    styles [
                      "heading",
                      "dim-label",
                    ]
                  }

                  CheckButton timestamps_check {
                    label: _("_Timestamps");
                    use-underline: true;
                    toggled => $_on_feature_check_toggled();
                  }

                  CheckButton speakers_check {
                    label: _("_Speakers");
                    use-underline: true;
                    toggled => $_on_feature_check_toggled();
                  }

                  Label hint_label {
                    xalign: 0;
                    wrap: true;
                    max-width-chars: 32;
                    margin-start: 6;
                    margin-end: 6;

                    styles [
                      "caption",
                      "dim-label",
                    ]
                  }
                }

                Separator {}

                Button {
                  label: _("_Manage Providers and Models…");
                  use-underline: true;
                  action-name: "app.preferences";

                  styles [
                    "flat",
                  ]
                }
              };
            };
          }

          Box {
            hexpand: true;
          }

          Button import_button {
            action-name: "win.import-audio";
            tooltip-text: _("Import Audio…");

            accessibility {
              label: _("Import Audio");
            }

            child: Box {
              spacing: 6;

              Image {
                icon-name: "folder-open-symbolic";
              }

              Label import_label {
                label: _("_Import Audio…");
                use-underline: true;
                mnemonic-widget: import_button;
              }
            };

            styles [
              "flat",
            ]
          }

          Button record_button {
            action-name: "win.start-recording";

            styles [
              "suggested-action",
            ]

            child: Adw.ButtonContent record_content {
              icon-name: "audio-input-microphone-symbolic";
              label: _("_Record");
              use-underline: true;
            };
          }

          styles [
            "toolbar",
          ]
        };
      }

      StackPage {
        name: "progress";

        child: Box {
          spacing: 9;

          Adw.Spinner {
            margin-start: 6;
          }

          Label progress_label {
            hexpand: true;
            xalign: 0;
            ellipsize: end;
          }

          Button cancel_button {
            label: _("_Cancel");
            use-underline: true;
            action-name: "win.cancel-import";
          }

          styles [
            "toolbar",
          ]
        };
      }

      StackPage {
        name: "recording";

        child: Box {
          spacing: 12;

          Box {
            spacing: 12;
            margin-start: 6;

            Image recording_dot {
              icon-name: "media-record-symbolic";
              pixel-size: 10;

              styles [
                "recording-indicator",
              ]
            }

            Label elapsed_label {
              label: "00:00";

              styles [
                "monospace",
                "numeric",
                "recording-time",
              ]
            }
          }

          Adw.Bin meter_slot {}

          Label recording_summary {
            hexpand: true;
            xalign: 0;
            ellipsize: end;
            max-width-chars: 38;

            styles [
              "caption",
              "dim-label",
            ]
          }

          Box {
            hexpand: true;
            visible: bind recording_summary.visible inverted;
          }

          Button pause_button {
            icon-name: "media-playback-pause-symbolic";
            tooltip-text: _("Pause Recording");
            action-name: "win.pause-recording";

            accessibility {
              label: _("Pause Recording");
            }

            styles [
              "circular",
            ]
          }

          Button stop_button {
            action-name: "win.stop-recording";

            styles [
              "suggested-action",
            ]

            child: Adw.ButtonContent {
              icon-name: "media-playback-stop-symbolic";
              label: _("_Stop");
              use-underline: true;
            };
          }

          styles [
            "toolbar",
          ]
        };
      }
    };
  };
}
