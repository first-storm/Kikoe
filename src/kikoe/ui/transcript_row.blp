using Gtk 4.0;

template $KikoeTranscriptRow: Box {
  orientation: vertical;

  Box header_box {
    orientation: vertical;
    spacing: 8;
    margin-top: 18;
    margin-bottom: 6;

    Box {
      spacing: 10;

      Label title_label {
        xalign: 0;
        yalign: 0;

        styles [
          "caption-heading",
        ]
      }

      Label meta_label {
        xalign: 0;
        yalign: 0;
        hexpand: true;
        wrap: true;

        styles [
          "caption",
          "dim-label",
        ]
      }
    }

    Separator {}
  }

  Box segment_box {
    spacing: 20;
    margin-top: 6;
    margin-bottom: 6;

    Box meta_box {
      orientation: vertical;
      spacing: 1;
      margin-top: 3;

      Label speaker_label {
        xalign: 0;
        ellipsize: end;

        styles [
          "heading",
        ]
      }

      Label timestamp_label {
        xalign: 0;

        styles [
          "caption",
          "monospace",
          "numeric",
          "dim-label",
        ]
      }
    }

    Label text_label {
      xalign: 0;
      yalign: 0;
      hexpand: true;
      wrap: true;
      wrap-mode: word_char;

      styles [
        "transcript-text",
      ]
    }
  }
}
