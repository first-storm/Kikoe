using Gtk 4.0;

template $KikoeTranscriptRow: Box {
  orientation: vertical;

  Box header_box {
    orientation: vertical;
    spacing: 8;
    margin-top: 18;
    margin-bottom: 6;

    Box {
      spacing: 10;

      Label title_label {
        xalign: 0;
        yalign: 0;

        styles [
          "caption-heading",
        ]
      }

      Label meta_label {
        xalign: 0;
        yalign: 0;
        hexpand: true;
        wrap: true;

        styles [
          "caption",
          "dim-label",
        ]
      }

      Button play_button {
        icon-name: "media-playback-start-symbolic";
        tooltip-text: _("Play This Recording");
        valign: center;

        styles [
          "flat",
          "circular",
        ]
      }

      MenuButton recording_menu_button {
        icon-name: "view-more-symbolic";
        tooltip-text: _("Recording Menu");
        valign: center;
        visible: false;
      }
    }

    Separator {}

    Box pending_box {
      spacing: 12;
      visible: false;

      Label pending_label {
        hexpand: true;
        xalign: 0;
        wrap: true;

        styles [
          "dim-label",
        ]
      }

      Button retry_button {
        label: _("_Retry Transcription");
        use-underline: true;
      }
    }
  }

  Box segment_box {
    spacing: 20;
    margin-top: 6;
    margin-bottom: 6;

    Box meta_box {
      orientation: vertical;
      spacing: 1;
      margin-top: 3;

      Button speaker_button {
        halign: start;
        tooltip-text: _("Rename or Match Speaker");

        styles [
          "flat",
          "speaker-button",
        ]

        child: Label speaker_label {
          xalign: 0;
          ellipsize: end;

          styles [
            "heading",
          ]
        };
      }

      Label timestamp_label {
        xalign: 0;

        styles [
          "caption",
          "monospace",
          "numeric",
          "dim-label",
        ]
      }
    }

    Label text_label {
      xalign: 0;
      yalign: 0;
      hexpand: true;
      wrap: true;
      wrap-mode: word_char;

      styles [
        "transcript-text",
      ]
    }
  }
}
