using Gtk 4.0;
using Adw 1;

template $KikoeTranscriptRow: Box {
  orientation: vertical;
  // The list row's padding, here so that a hidden spare row takes no room.
  margin-top: 2;
  margin-bottom: 2;
  margin-start: 2;
  margin-end: 2;

  Box header_box {
    orientation: vertical;
    spacing: 2;
    margin-top: 24;
    margin-bottom: 10;
    margin-start: 8;

    Box {
      spacing: 6;

      Label title_label {
        xalign: 0;
        hexpand: true;
        valign: center;

        styles [
          "heading",
        ]
      }

      Button play_button {
        icon-name: "media-playback-start-symbolic";
        tooltip-text: _("Play This Recording");
        valign: center;

        accessibility {
          label: _("Play This Recording");
        }

        styles [
          "flat",
          "circular",
        ]
      }

      MenuButton recording_menu_button {
        icon-name: "view-more-symbolic";
        tooltip-text: _("Recording Menu");
        valign: center;
        visible: false;

        accessibility {
          label: _("Recording Menu");
        }

        styles [
          "flat",
          "circular",
        ]
      }
    }

    Label meta_label {
      xalign: 0;
      wrap: true;
      wrap-mode: word_char;

      styles [
        "caption",
        "dimmed",
      ]
    }

    Box pending_box {
      spacing: 12;
      margin-top: 8;
      visible: false;

      Label pending_label {
        hexpand: true;
        xalign: 0;
        wrap: true;

        styles [
          "dimmed",
        ]
      }

      Button retry_button {
        label: _("_Retry Transcription");
        use-underline: true;
      }
    }
  }

  Box segment_box {
    spacing: 12;

    Box meta_box {
      orientation: vertical;
      margin-start: 8;
      margin-top: 4;

      Button speaker_button {
        halign: start;
        action-name: "win.edit-speaker";
        // (recording id, speaker id), set for each segment shown.
        action-target: "('', '')";
        tooltip-text: _("Rename or Match Speaker");

        accessibility {
          label: _("Rename or Match Speaker");
        }

        styles [
          "flat",
          "speaker-button",
        ]

        child: Label speaker_label {
          xalign: 0;
          ellipsize: end;

          styles [
            "heading",
          ]
        };
      }

      MenuButton timestamp_button {
        halign: start;
        tooltip-text: _("Edit Timestamps");

        accessibility {
          label: _("Edit Timestamps");
        }

        styles [
          "flat",
          "timestamp-button",
        ]

        child: Label timestamp_label {
          xalign: 0;
          ellipsize: end;

          styles [
            "caption",
            "numeric",
            "dimmed",
          ]
        };

        popover: Popover timestamp_popover {
          closed => $_on_timestamp_popover_closed();

          child: Box {
            orientation: vertical;
            spacing: 12;
            width-request: 260;
            margin-top: 6;
            margin-bottom: 6;
            margin-start: 6;
            margin-end: 6;

            Grid {
              column-spacing: 12;
              row-spacing: 12;

              Label {
                label: _("_Start");
                use-underline: true;
                mnemonic-widget: start_row;
                xalign: 0;

                layout {
                  column: 0;
                  row: 0;
                }
              }

              Entry start_row {
                hexpand: true;
                width-chars: 12;
                max-width-chars: 12;
                changed => $_on_time_row_changed();
                activate => $_on_time_row_entry_activated();

                accessibility {
                  label: _("Start");
                }

                layout {
                  column: 1;
                  row: 0;
                }
              }

              Label {
                label: _("_End");
                use-underline: true;
                mnemonic-widget: end_row;
                xalign: 0;

                layout {
                  column: 0;
                  row: 1;
                }
              }

              Entry end_row {
                hexpand: true;
                width-chars: 12;
                max-width-chars: 12;
                changed => $_on_time_row_changed();
                activate => $_on_time_row_entry_activated();

                accessibility {
                  label: _("End");
                }

                layout {
                  column: 1;
                  row: 1;
                }
              }
            }

            Label times_hint_label {
              label: _("Use MM:SS or H:MM:SS, with optional decimal seconds (e.g. 00:26.860). Leave empty to clear");
              xalign: 0;
              wrap: true;
              max-width-chars: 30;

              styles [
                "caption",
                "dimmed",
              ]
            }

            Label times_error_label {
              visible: false;
              xalign: 0;
              wrap: true;
              max-width-chars: 30;

              styles [
                "caption",
                "error",
              ]
            }
          };
        };
      }
    }

    Stack text_stack {
      hexpand: true;
      hhomogeneous: false;
      vhomogeneous: false;

      StackPage {
        name: "edit";
        // The segment's text view, added from Python.
        child: Adw.Bin text_slot {};
      }

      StackPage {
        name: "live";

        child: Label text_label {
          xalign: 0;
          yalign: 0;
          wrap: true;
          wrap-mode: word_char;
          margin-top: 6;
          margin-bottom: 6;
          margin-start: 8;
          margin-end: 8;

          styles [
            "transcript-text",
          ]
        };
      }
    }
  }
}
