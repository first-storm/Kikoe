using Gtk 4.0;
using Adw 1;

template $KikoePreferencesDialog: Adw.PreferencesDialog {
  title: _("Preferences");
  content-width: 640;
  content-height: 600;
  closed => $_on_dialog_closed();

  Adw.PreferencesPage {
    name: "general";
    title: _("General");
    icon-name: "preferences-system-symbolic";

    Adw.PreferencesGroup {
      title: _("Transcription");
      description: _(
        "Defaults for the next transcription. Language is detected automatically when left empty. To set it, enter a language code such as zh, en, or ja. Custom vocabulary and live delay are used by Mistral Voxtral 3 models."
      );

      Adw.EntryRow language_row {
        title: _("Transcription Language");
        show-apply-button: true;
        apply => $_on_language_row_apply();
      }

      Label language_error {
        label: _("Enter a language code such as zh, en, or ja.");
        wrap: true;
        xalign: 0;
        margin-top: 6;
        visible: false;

        styles [
          "error",
        ]
      }

      Adw.EntryRow vocabulary_row {
        title: _("Custom Vocabulary");
        show-apply-button: true;
        apply => $_on_vocabulary_row_apply();
      }

      Label vocabulary_error {
        label: _("Use up to 100 terms of at most 100 characters each, separated by commas.");
        wrap: true;
        xalign: 0;
        margin-top: 6;
        visible: false;

        styles [
          "error",
        ]
      }

      Adw.SpinRow realtime_delay_row {
        title: _("Live Transcription Delay");
        subtitle: _("In milliseconds. Shorter delays are faster but less accurate. 0 uses the service default.");
        notify::value => $_on_realtime_delay_row_notify_value();

        adjustment: Adjustment {
          lower: 0;
          upper: 2400;
          value: 0;
        };
      }
    }

    Adw.PreferencesGroup {
      title: _("Audio");

      Adw.ComboRow input_device_row {
        title: _("Microphone");
        subtitle: _("Used for new recordings");
        use-markup: false;
        notify::selected => $_on_input_device_row_notify_selected();
      }

      Adw.ComboRow output_device_row {
        title: _("Audio Output");
        subtitle: _("Used for playback");
        use-markup: false;
        notify::selected => $_on_output_device_row_notify_selected();
      }
    }

    Adw.PreferencesGroup {
      title: _("Storage");

      Adw.ActionRow data_row {
        title: _("Data Folder");
        subtitle-lines: 2;
        use-markup: false;
        activatable: true;
        action-name: "app.open-data-folder";

        [suffix]
        Image {
          icon-name: "folder-open-symbolic";
        }
      }
    }

    Adw.PreferencesGroup {
      title: _("Troubleshooting");
      description: _(
        "Logs stay on this device. Nothing is uploaded automatically. You can attach a log when reporting a problem."
      );

      Adw.ActionRow log_row {
        title: _("Log Folder");
        subtitle-lines: 2;
        use-markup: false;
        activatable: true;
        action-name: "app.open-log-folder";

        [suffix]
        Image {
          icon-name: "folder-open-symbolic";
        }
      }
    }
  }

  Adw.PreferencesPage {
    name: "providers";
    title: _("Providers");
    icon-name: "network-server-symbolic";

    Adw.PreferencesGroup providers_group {
      title: _("Providers");
      description: _("Transcription happens in the cloud. A provider can offer several models.");

      header-suffix: Button {
        valign: center;
        clicked => $_on_add_provider_button_clicked();

        child: Adw.ButtonContent {
          icon-name: "list-add-symbolic";
          label: _("_Add Provider");
          use-underline: true;
        };
      };

      ListBox providers_list {
        selection-mode: none;

        styles [
          "boxed-list",
        ]

        [placeholder]
        Label {
          label: _("No Providers Yet");
          margin-top: 12;
          margin-bottom: 12;

          styles [
            "dimmed",
          ]
        }
      }
    }
  }
}
