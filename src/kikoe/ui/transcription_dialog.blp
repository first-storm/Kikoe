using Gtk 4.0;
using Adw 1;

template $KikoeTranscriptionDialog: Adw.Dialog {
  title: _("Transcription Model");
  content-width: 440;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {}

    content: Adw.PreferencesPage {
      Adw.PreferencesGroup {
        Box models_box {
          orientation: vertical;
          spacing: 24;
        }
      }

      Adw.PreferencesGroup options_group {
        title: _("Options");

        Adw.SwitchRow timestamps_row {
          title: _("_Timestamps");
          use-underline: true;
          notify::active => $_on_option_row_notify_active();
        }

        Adw.ComboRow granularity_row {
          title: _("Timestamp _Detail");
          use-underline: true;
          notify::selected => $_on_granularity_row_notify_selected();

          model: StringList {
            strings [
              _("Segments"),
              _("Words"),
              _("Segments and Words"),
            ]
          };
        }

        Adw.SwitchRow speakers_row {
          title: _("_Speakers");
          use-underline: true;
          notify::active => $_on_option_row_notify_active();
        }
      }

      Adw.PreferencesGroup {
        Adw.ButtonRow {
          title: _("_Manage Providers and Models…");
          use-underline: true;
          activated => $_on_manage_row_activated();
        }
      }
    };
  };
}
