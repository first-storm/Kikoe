using Gtk 4.0;
using Adw 1;

template $KikoeNoteView: Adw.Bin {
  child: Box {
    orientation: vertical;

    Adw.Banner speaker_banner {
      revealed: false;
      button-label: _("Match Speakers…");
    }

    Stack stack {
      hhomogeneous: false;
      vhomogeneous: false;
      vexpand: true;

      StackPage {
        name: "transcript";

        child: ScrolledWindow transcript_scroll {
          hscrollbar-policy: never;

          styles [
            "view",
          ]

          child: Adw.ClampScrollable {
            maximum-size: 760;
            tightening-threshold: 600;

            child: ListView transcript_list {
              margin-start: 24;
              margin-end: 24;
              margin-bottom: 32;
            };
          };
        };
      }

      StackPage {
        name: "no-recordings";

        child: Adw.StatusPage {
          icon-name: "audio-x-generic-symbolic";
          title: _("No Recordings Yet");
          description: _("Record or import audio to add a transcript to this note.");
        };
      }
    }

    Adw.Clamp {
      maximum-size: 760;
      tightening-threshold: 600;

      child: Adw.Bin recording_slot {
        visible: false;
        vexpand: true;
      };
    }
  };
}
