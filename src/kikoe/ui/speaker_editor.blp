using Gtk 4.0;
using Adw 1;

template $KikoeSpeakerEditor: Adw.Dialog {
  title: _("Rename Speaker");
  content-width: 400;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-start-title-buttons: false;
      show-end-title-buttons: false;

      [start]
      Button {
        label: _("_Cancel");
        use-underline: true;
        clicked => $_on_cancel_button_clicked();
      }

      [end]
      Button save_button {
        label: _("_Save");
        use-underline: true;
        clicked => $_on_save_button_clicked();

        styles [
          "suggested-action",
        ]
      }
    }

    content: Adw.PreferencesPage {
      Adw.PreferencesGroup {
        Adw.EntryRow name_row {
          title: _("Name");
          changed => $_on_name_row_changed();
        }

        Adw.ButtonRow {
          title: _("Match Speakers…");
          activated => $_on_match_row_activated();
        }
      }
    };
  };
}
