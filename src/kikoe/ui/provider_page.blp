using Gtk 4.0;
using Adw 1;

template $KikoeProviderPage: Adw.NavigationPage {
  title: _("Add Provider");
  hidden => $_on_page_hidden();

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      [end]
      Button add_button {
        label: _("_Add");
        use-underline: true;
        clicked => $_on_add_button_clicked();

        styles [
          "suggested-action",
        ]
      }
    }

    content: Adw.PreferencesPage {
      Adw.PreferencesGroup {
        title: _("Connection");
        description: _("The API type decides the request format. Most providers offer an “OpenAI-compatible” API.");

        Adw.EntryRow name_row {
          title: _("Name");
          apply => $_on_row_apply();
        }

        Adw.ComboRow api_row {
          title: _("API Type");
          notify::selected => $_on_api_row_notify_selected();
        }

        Adw.EntryRow base_url_row {
          title: _("Base URL");
          input-purpose: url;
          apply => $_on_row_apply();
        }

        Adw.PasswordEntryRow api_key_row {
          title: _("API Key");
          apply => $_on_row_apply();
        }

        Label error_label {
          visible: false;
          wrap: true;
          xalign: 0;
          margin-top: 6;
          margin-start: 6;
          margin-end: 6;

          styles [
            "error",
          ]
        }
      }

      Adw.PreferencesGroup llm_group {
        title: _("Audio LLM");
        description: _(
          "Any chat model that accepts audio can transcribe when given a prompt. Results have no timestamps or speakers."
        );
        visible: false;

        Adw.ComboRow format_row {
          title: _("Request Format");
          notify::selected => $_on_format_row_notify_selected();
        }
      }

      Adw.PreferencesGroup prompt_group {
        title: _("Prompt");
        description: _("Sent with each audio chunk. A chosen transcription language is added as a hint.");
        visible: false;

        header-suffix: Button {
          valign: center;
          label: _("_Reset");
          use-underline: true;
          tooltip-text: _("Restore the default prompt");
          clicked => $_on_reset_prompt_button_clicked();
        };

        ScrolledWindow {
          hscrollbar-policy: never;
          min-content-height: 180;
          max-content-height: 360;
          propagate-natural-height: true;

          child: TextView prompt_view {
            wrap-mode: word_char;
            top-margin: 12;
            bottom-margin: 12;
            left-margin: 12;
            right-margin: 12;

            accessibility {
              label: _("Prompt");
            }

            styles [
              "inline",
            ]
          };

          styles [
            "card",
          ]
        }
      }

      Adw.PreferencesGroup upload_group {
        title: _("File Transcription");
        description: _(
          "Applies to imported audio, recordings transcribed after stopping, and re-transcription. Smaller chunks allow more parallel requests."
        );

        Adw.SpinRow parallel_row {
          title: _("Parallel Requests");
          subtitle: _("1 processes chunks one at a time; account rate limits still apply");

          adjustment: Adjustment {
            lower: 1;
            upper: 32;
            value: 2;
          };

          notify::value => $_on_upload_row_changed();
        }

        Adw.SpinRow chunk_length_row {
          title: _("Chunk Length (Minutes)");
          subtitle: _("0 uses the provider limit; chunks also respect the size limit");
          digits: 1;

          adjustment: Adjustment {
            lower: 0;
            upper: 1440;
            value: 0;
          };

          notify::value => $_on_upload_row_changed();
        }

        Adw.SpinRow chunk_size_row {
          title: _("Chunk Size (MB)");
          digits: 1;

          adjustment: Adjustment {
            lower: 0.1;
            upper: 2000;
            value: 25;
          };

          notify::value => $_on_upload_row_changed();
        }

        Adw.ComboRow upload_format_row {
          title: _("Audio Format");
          notify::selected => $_on_upload_row_changed();
        }

        Adw.ButtonRow {
          title: _("Reset Transcription Defaults");
          activated => $_on_reset_upload_activated();
        }
      }

      Adw.PreferencesGroup models_group {
        title: _("Models");
        description: _("What each model can do is set when you add it.");
        visible: false;

        header-suffix: Button {
          valign: center;
          clicked => $_on_add_model_button_clicked();

          child: Adw.ButtonContent {
            icon-name: "list-add-symbolic";
            label: _("Add _Model");
            use-underline: true;
          };
        };

        ListBox models_list {
          selection-mode: none;

          styles [
            "boxed-list",
          ]

          [placeholder]
          Label {
            label: _("No Models Yet");
            margin-top: 12;
            margin-bottom: 12;

            styles [
              "dimmed",
            ]
          }
        }
      }

      Adw.PreferencesGroup remove_group {
        visible: false;

        Adw.ButtonRow {
          title: _("_Remove Provider");
          use-underline: true;
          activated => $_on_remove_row_activated();

          styles [
            "destructive-action",
          ]
        }
      }
    };
  };
}
