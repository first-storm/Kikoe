#, python-brace-format
msgid "{subject} could not process this audio (HTTP {status})."
msgstr "{subject} bu sesi işleyemedi (HTTP {status})."

#: src/kikoe/providers/errors.py:84
#, python-brace-format
msgid ""
"{subject} rejected this request (HTTP {status}). Check the model and options."
msgstr ""
"{subject} bu isteği reddetti (HTTP {status}). Modeli ve seçenekleri "
"denetleyin."

