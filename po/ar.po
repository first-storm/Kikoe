msgstr "لم تعد هذه الملاحظة موجودة."

#: src/kikoe/storage/providers.py:83 src/kikoe/storage/providers.py:206
#, python-brace-format
msgid "Provider {provider_id} no longer exists."
msgstr "لم يعد مزوّد الخدمة {provider_id} موجودًا."

#: src/kikoe/storage/providers.py:184
#, python-brace-format
msgid "Model {replacing_id} no longer exists."
msgstr "لم يعد النموذج {replacing_id} موجودًا."

#: src/kikoe/storage/secrets.py:67
#, python-brace-format
msgid ""
"API keys could not be saved because no secure credential store is available. "
"Details: {error}"
msgstr ""
"تعذّر حفظ مفاتيح API لعدم توفر مخزن آمن لبيانات الاعتماد. التفاصيل: {error}"

#: src/kikoe/storage/settings.py:64
#, python-brace-format
msgid "Could not read the settings file: {error}"
msgstr "تعذّرت قراءة ملف الإعدادات: {error}"

#: src/kikoe/storage/settings.py:76
#, python-brace-format
msgid "The settings file {detail} is damaged or not understood: {error}"
msgstr "ملف الإعدادات {detail} تالف أو غير مفهوم: {error}"

#: src/kikoe/storage/settings.py:101
#, python-brace-format
msgid "Could not save the settings file: {error}"
msgstr "تعذّر حفظ ملف الإعدادات: {error}"

