#: src/kikoe/storage/library.py:290
msgid "The end time must be after the start time."
msgstr "يجب أن يكون وقت النهاية بعد وقت البداية."

#: src/kikoe/storage/library.py:307
msgid "Enter a speaker name."
msgstr "أدخل اسم المتحدث."

