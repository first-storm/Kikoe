#, python-brace-format
msgid ""
"Could not open the microphone. Check your input device and microphone "
"permissions. ({detail})"
msgstr ""
"Impossible d’ouvrir le microphone. Vérifiez le périphérique d’entrée et les "
"autorisations du microphone. ({detail})"

#: src/kikoe/media/recorder.py:117
msgid "The microphone lost audio. The captured audio has been kept."
msgstr "Le microphone a perdu de l’audio. L’audio capturé a été conservé."

#: src/kikoe/media/recorder.py:129
msgid "Audio could not be saved fast enough. The captured audio has been kept."
msgstr ""
"L’audio n’a pas pu être enregistré assez vite. L’audio capturé a été "
"conservé."

#: src/kikoe/media/recorder.py:152
msgid "The microphone disconnected. The captured audio has been kept."
msgstr "Le microphone a été déconnecté. L’audio capturé a été conservé."

#: src/kikoe/media/recorder.py:177
#, python-brace-format
msgid "The microphone stopped responding. ({detail})"
msgstr "Le microphone ne répond plus. ({detail})"

#: src/kikoe/media/recorder.py:196
#, python-brace-format
msgid "Could not close the microphone. ({detail})"
msgstr "Impossible de fermer le microphone. ({detail})"

#: src/kikoe/media/transcode.py:78
#, python-brace-format
msgid "“{name}” contains no audio."
msgstr "“{name}” ne contient pas d’audio."

#: src/kikoe/media/transcode.py:128
#, python-brace-format
msgid ""
"Could not read “{name}”. It may not be an audio file, or it is damaged. "
"({detail})"
msgstr ""
"Impossible de lire “{name}”. Ce fichier est peut-être endommagé ou ne "
"contient pas d’audio. ({detail})"

#. Translators: {name} is a service name such as Groq.
#: src/kikoe/providers/base.py:91
#, python-brace-format
msgid "{name} supports file transcription only."
msgstr "{name} ne prend en charge que la transcription de fichiers."

#: src/kikoe/providers/deepgram.py:204
#, python-brace-format
msgid "Deepgram rejected realtime transcription: {message}"
msgstr "Deepgram a refusé la transcription en temps réel : {message}"

#: src/kikoe/providers/deepgram.py:209
#: src/kikoe/providers/mistral_realtime.py:119
msgid ""
"The provider rejected realtime transcription. Check the model and API key."
msgstr ""
"Le fournisseur a refusé la transcription en temps réel. Vérifiez le modèle "
"et la clé API."

#: src/kikoe/providers/errors.py:37
#, python-brace-format
msgid "{host} sent a response Kikoe does not understand."
msgstr "{host} a envoyé une réponse que Kikoe ne comprend pas."

#: src/kikoe/providers/errors.py:60
#, python-brace-format
msgid "{subject} rejected the API key. Check it in Preferences."
msgstr "{subject} a refusé la clé API. Vérifiez-la dans les préférences."

#: src/kikoe/providers/errors.py:63
#, python-brace-format
msgid ""
"{subject} does not allow this API key to use this model, or is not available "
"in your region. Check your account and the key in Preferences."
msgstr ""
"{subject} n’autorise pas cette clé API à utiliser ce modèle ou n’est pas "
"disponible dans votre région. Vérifiez votre compte et la clé dans les "
"préférences."

#: src/kikoe/providers/errors.py:67
#, python-brace-format
msgid "{subject} reports that your account has run out of credits."
msgstr "{subject} indique que votre compte n’a plus de crédits."

#: src/kikoe/providers/errors.py:69
#, python-brace-format
msgid "{subject} could not find this model. Check the model name."
msgstr "{subject} n’a pas trouvé ce modèle. Vérifiez son nom."

#: src/kikoe/providers/errors.py:71
#, python-brace-format
msgid "{subject} took too long to respond. Try again later."
msgstr "{subject} a mis trop de temps à répondre. Réessayez plus tard."

#: src/kikoe/providers/errors.py:73
#, python-brace-format
msgid "The audio is too large for {subject}."
msgstr "L’audio est trop volumineux pour {subject}."

#: src/kikoe/providers/errors.py:76
#, python-brace-format
msgid ""
"{subject} is limiting requests, or your quota is used up. Wait a while and "
"try again, or check your plan."
msgstr ""
"{subject} limite les requêtes ou votre quota est épuisé. Patientez et "
"réessayez, ou vérifiez votre offre."

#: src/kikoe/providers/errors.py:80
#, python-brace-format
msgid "{subject} is having problems (HTTP {status}). Try again later."
msgstr ""
"{subject} rencontre des problèmes (HTTP {status}). Réessayez plus tard."

#: src/kikoe/providers/errors.py:82
#, python-brace-format
msgid "{subject} could not process this audio (HTTP {status})."
msgstr "{subject} n’a pas pu traiter cet audio (HTTP {status})."

#: src/kikoe/providers/errors.py:85
#, python-brace-format
msgid ""
"{subject} rejected this request (HTTP {status}). Check the model and options."
msgstr ""
"{subject} a refusé cette requête (HTTP {status}). Vérifiez le modèle et les "
"options."

#: src/kikoe/providers/errors.py:88
#, python-brace-format
msgid "{subject} returned an unexpected error (HTTP {status})."
msgstr "{subject} a renvoyé une erreur inattendue (HTTP {status})."

#: src/kikoe/providers/errors.py:93
#, python-brace-format
msgid "{message} Details: {detail}"
msgstr "{message} Détails : {detail}"

#: src/kikoe/providers/errors.py:101
msgid "The provider sent a response Kikoe does not understand."
msgstr "Le fournisseur a envoyé une réponse que Kikoe ne comprend pas."

#: src/kikoe/providers/errors.py:105
msgid "The provider"
msgstr "Le fournisseur"

#: src/kikoe/providers/errors.py:107
msgid "Could not complete transcription. Check your connection and try again."
msgstr ""
"Impossible de terminer la transcription. Vérifiez votre connexion et "
"réessayez."

#: src/kikoe/providers/errors.py:125 src/kikoe/providers/mistral.py:100
#, python-brace-format
msgid "{host} took too long to respond. Try again later."
msgstr "{host} a mis trop de temps à répondre. Réessayez plus tard."

#: src/kikoe/providers/errors.py:127 src/kikoe/providers/mistral.py:103
#: src/kikoe/providers/mistral.py:146
#, python-brace-format
msgid "Could not reach {host}. Try again later."
msgstr "Impossible de joindre {host}. Réessayez plus tard."

#: src/kikoe/providers/errors.py:130
#, python-brace-format
msgid "{host} could not finish transcription: {message}"
msgstr "{host} n’a pas pu terminer la transcription : {message}"

#: src/kikoe/providers/factory.py:77
msgid "Local models are not available."
msgstr "Les modèles locaux ne sont pas disponibles."

#: src/kikoe/providers/local/client.py:55
#, python-brace-format
msgid "“{model}” is no longer downloaded. Download it again in Preferences."
msgstr ""
"« {model} » n’est plus téléchargé. Téléchargez-le à nouveau dans les "
"Préférences."

#: src/kikoe/providers/local/client.py:107
msgid "This local model transcribes files only."
msgstr "Ce modèle local transcrit uniquement des fichiers."

#: src/kikoe/providers/local/client.py:119
#, python-brace-format
msgid "Select a language before transcribing with “{model}”."
msgstr "Sélectionnez une langue avant de transcrire avec « {model} »."

#: src/kikoe/providers/local/client.py:125
#, python-brace-format
msgid ""
"“{model}” does not support the selected language. Choose another language."
msgstr ""
"« {model} » ne prend pas en charge la langue sélectionnée. Choisissez une "
"autre langue."

#: src/kikoe/providers/local/connection.py:101
msgid "The local engine returned an unreadable result."
msgstr "Le moteur local a renvoyé un résultat illisible."

#: src/kikoe/providers/local/connection.py:125
msgid ""
"The local engine could not start. Try another acceleration option in "
"Preferences, or download the engine again."
msgstr ""
"Le moteur local n’a pas pu démarrer. Essayez une autre option d’accélération "
"dans les Préférences, ou téléchargez à nouveau le moteur."

