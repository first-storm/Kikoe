#, python-brace-format
msgid "Could not decode the audio: {detail}"
msgstr "Impossible de décoder l’audio : {detail}"

#: src/kikoe/media/player.py:73
msgid "No default audio output device is available."
msgstr "Aucun périphérique de sortie audio par défaut n’est disponible."

#: src/kikoe/media/player.py:108
#, python-brace-format
msgid "Could not play the audio. Check your output device. ({detail})"
msgstr ""
"Impossible de lire l’audio. Vérifiez votre périphérique de sortie. ({detail})"

