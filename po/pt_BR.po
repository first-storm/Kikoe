msgstr "O horário de término deve ser posterior ao de início."

#: src/kikoe/storage/library.py:307
msgid "Enter a speaker name."
msgstr "Digite o nome do falante."

#: src/kikoe/storage/library.py:329
msgid "The speaker selection is no longer available."
msgstr "A seleção de falante não está mais disponível."

#: src/kikoe/storage/library.py:415
#, python-brace-format
msgid "The note library could not be read or saved: {error}"
msgstr "Não foi possível ler ou salvar a biblioteca de notas: {error}"

#: src/kikoe/storage/local_installs.py:180
msgid "Could not finish installing. Check the free disk space."
msgstr ""
"Não foi possível concluir a instalação. Verifique o espaço livre em disco."

#: src/kikoe/storage/local_installs.py:192
msgid "Could not remove the files. They may be in use."
msgstr "Não foi possível remover os arquivos. Eles podem estar em uso."

#: src/kikoe/storage/local_installs.py:210
#, python-brace-format
msgid "“{name}” could not be unpacked."
msgstr "Não foi possível descompactar “{name}”."

#: src/kikoe/storage/local_installs.py:221
