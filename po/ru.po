#: src/kikoe/storage/providers.py:184
#, python-brace-format
msgid "Model {replacing_id} no longer exists."
msgstr "Модель {replacing_id} больше не существует."

#: src/kikoe/storage/secrets.py:67
#, python-brace-format
msgid ""
"API keys could not be saved because no secure credential store is available. "
