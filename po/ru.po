msgid "Could not open the folder."
msgstr "Не удалось открыть папку."

#. Translators: replace with your name(s), one per line.
#: src/kikoe/application.py:209
msgid "translator-credits"
msgstr "Kikoe contributors"

#: src/kikoe/media/ffmpeg.py:54
#, python-brace-format
msgid "KIKOE_FFMPEG points to a missing file: {path}"
msgstr "KIKOE_FFMPEG указывает на отсутствующий файл: {path}"

#: src/kikoe/media/ffmpeg.py:65
msgid "ffmpeg was not found. Install it or set KIKOE_FFMPEG."
msgstr "ffmpeg не найден. Установите его или задайте KIKOE_FFMPEG."

#: src/kikoe/media/ffmpeg.py:107
#, python-brace-format
msgid "ffmpeg exited with status {status}: {error}"
msgstr "ffmpeg завершился с кодом {status}: {error}"

#: src/kikoe/media/ffmpeg.py:167
msgid "The audio converter stopped unexpectedly."
msgstr "Конвертер аудио неожиданно остановился."

#: src/kikoe/media/ffmpeg.py:183
#, python-brace-format
msgid "The audio converter failed: {detail}"
msgstr "Ошибка конвертации аудио: {detail}"

#: src/kikoe/media/ffmpeg.py:239
#, python-brace-format
msgid "Could not decode the audio: {detail}"
msgstr "Не удалось декодировать аудио: {detail}"

#: src/kikoe/media/player.py:73
msgid "No default audio output device is available."
msgstr "Устройство вывода звука по умолчанию недоступно."

#: src/kikoe/media/player.py:108
#, python-brace-format
msgid "Could not play the audio. Check your output device. ({detail})"
msgstr ""
"Не удалось воспроизвести аудио. Проверьте устройство вывода. ({detail})"

#: src/kikoe/media/player.py:119
#, python-brace-format
msgid "Could not close the audio output device. ({detail})"
msgstr "Не удалось закрыть устройство вывода звука. ({detail})"

#: src/kikoe/media/recorder.py:107
#, python-brace-format
msgid ""
"Could not open the microphone. Check your input device and microphone "
"permissions. ({detail})"
msgstr ""
"Не удалось открыть микрофон. Проверьте устройство ввода и разрешения "
"микрофона. ({detail})"

#: src/kikoe/media/recorder.py:117
msgid "The microphone lost audio. The captured audio has been kept."
msgstr "Микрофон потерял аудиоданные. Записанное аудио сохранено."

#: src/kikoe/media/recorder.py:129
msgid "Audio could not be saved fast enough. The captured audio has been kept."
msgstr ""
"Не удалось сохранить аудио достаточно быстро. Записанное аудио сохранено."

#: src/kikoe/media/recorder.py:152
msgid "The microphone disconnected. The captured audio has been kept."
msgstr "Микрофон отключён. Записанное аудио сохранено."

#: src/kikoe/media/recorder.py:177
#, python-brace-format
msgid "The microphone stopped responding. ({detail})"
msgstr "Микрофон перестал отвечать. ({detail})"

#: src/kikoe/media/recorder.py:196
#, python-brace-format
msgid "Could not close the microphone. ({detail})"
msgstr "Не удалось закрыть микрофон. ({detail})"

#: src/kikoe/media/transcode.py:78
#, python-brace-format
msgid "“{name}” contains no audio."
msgstr "“{name}” не содержит аудио."

#: src/kikoe/media/transcode.py:128
#, python-brace-format
msgid ""
"Could not read “{name}”. It may not be an audio file, or it is damaged. "
"({detail})"
msgstr ""
"Не удалось прочитать “{name}”. Возможно, это не аудиофайл или он повреждён. "
"({detail})"

#. Translators: {name} is a service name such as Groq.
#: src/kikoe/providers/base.py:91
#, python-brace-format
msgid "{name} supports file transcription only."
msgstr "{name} поддерживает только расшифровку файлов."

#: src/kikoe/providers/deepgram.py:204
#, python-brace-format
msgid "Deepgram rejected realtime transcription: {message}"
msgstr "Deepgram отклонил расшифровку в реальном времени: {message}"

#: src/kikoe/providers/deepgram.py:209
#: src/kikoe/providers/mistral_realtime.py:119
msgid ""
"The provider rejected realtime transcription. Check the model and API key."
msgstr ""
"Провайдер отклонил расшифровку в реальном времени. Проверьте модель и ключ "
"API."

#: src/kikoe/providers/errors.py:37
#, python-brace-format
msgid "{host} sent a response Kikoe does not understand."
msgstr "{host} отправил ответ, который Kikoe не понимает."

#: src/kikoe/providers/errors.py:60
#, python-brace-format
msgid "{subject} rejected the API key. Check it in Preferences."
msgstr "{subject} отклонил ключ API. Проверьте его в настройках."

#: src/kikoe/providers/errors.py:63
#, python-brace-format
msgid ""
"{subject} does not allow this API key to use this model, or is not available "
"in your region. Check your account and the key in Preferences."
msgstr ""
"{subject} не разрешает этому ключу API использовать модель или недоступен в "
"вашем регионе. Проверьте аккаунт и ключ в настройках."

#: src/kikoe/providers/errors.py:67
#, python-brace-format
msgid "{subject} reports that your account has run out of credits."
msgstr "{subject} сообщает, что на вашем аккаунте закончились средства."

#: src/kikoe/providers/errors.py:69
#, python-brace-format
msgid "{subject} could not find this model. Check the model name."
msgstr "{subject} не нашёл эту модель. Проверьте название модели."

#: src/kikoe/providers/errors.py:71
#, python-brace-format
msgid "{subject} took too long to respond. Try again later."
msgstr "{subject} слишком долго отвечал. Повторите попытку позже."

#: src/kikoe/providers/errors.py:73
#, python-brace-format
msgid "The audio is too large for {subject}."
msgstr "Аудио слишком большое для {subject}."

#: src/kikoe/providers/errors.py:76
#, python-brace-format
msgid ""
"{subject} is limiting requests, or your quota is used up. Wait a while and "
"try again, or check your plan."
msgstr ""
"{subject} ограничивает запросы или ваша квота исчерпана. Подождите и "
"повторите попытку или проверьте тариф."

#: src/kikoe/providers/errors.py:80
#, python-brace-format
msgid "{subject} is having problems (HTTP {status}). Try again later."
msgstr ""
"У {subject} возникли проблемы (HTTP {status}). Повторите попытку позже."

#: src/kikoe/providers/errors.py:82
#, python-brace-format
msgid "{subject} could not process this audio (HTTP {status})."
msgstr "{subject} не смог обработать аудио (HTTP {status})."

#: src/kikoe/providers/errors.py:85
#, python-brace-format
msgid ""
"{subject} rejected this request (HTTP {status}). Check the model and options."
msgstr ""
"{subject} отклонил запрос (HTTP {status}). Проверьте модель и параметры."

#: src/kikoe/providers/errors.py:88
#, python-brace-format
msgid "{subject} returned an unexpected error (HTTP {status})."
msgstr "{subject} вернул непредвиденную ошибку (HTTP {status})."

#: src/kikoe/providers/errors.py:93
#, python-brace-format
msgid "{message} Details: {detail}"
msgstr "{message} Подробности: {detail}"

#: src/kikoe/providers/errors.py:101
msgid "The provider sent a response Kikoe does not understand."
msgstr "Провайдер отправил ответ, который Kikoe не понимает."

#: src/kikoe/providers/errors.py:105
msgid "The provider"
msgstr "Провайдер"

#: src/kikoe/providers/errors.py:107
msgid "Could not complete transcription. Check your connection and try again."
msgstr ""
"Не удалось завершить расшифровку. Проверьте соединение и повторите попытку."

#: src/kikoe/providers/errors.py:125 src/kikoe/providers/mistral.py:100
#, python-brace-format
msgid "{host} took too long to respond. Try again later."
msgstr "{host} слишком долго отвечал. Повторите попытку позже."

#: src/kikoe/providers/errors.py:127 src/kikoe/providers/mistral.py:103
#: src/kikoe/providers/mistral.py:146
#, python-brace-format
msgid "Could not reach {host}. Try again later."
msgstr "Не удалось подключиться к {host}. Повторите попытку позже."

#: src/kikoe/providers/errors.py:130
#, python-brace-format
msgid "{host} could not finish transcription: {message}"
msgstr "{host} не смог завершить расшифровку: {message}"

#: src/kikoe/providers/factory.py:77
msgid "Local models are not available."
msgstr "Локальные модели недоступны."

#: src/kikoe/providers/local/client.py:55
#, python-brace-format
msgid "“{model}” is no longer downloaded. Download it again in Preferences."
msgstr "«{model}» больше не загружена. Загрузите её снова в настройках."

#: src/kikoe/providers/local/client.py:107
msgid "This local model transcribes files only."
msgstr "Эта локальная модель расшифровывает только файлы."

#: src/kikoe/providers/local/client.py:119
#, python-brace-format
msgid "Select a language before transcribing with “{model}”."
msgstr "Выберите язык перед транскрипцией с помощью «{model}»."

#: src/kikoe/providers/local/client.py:125
#, python-brace-format
msgid ""
"“{model}” does not support the selected language. Choose another language."
msgstr "«{model}» не поддерживает выбранный язык. Выберите другой язык."

#: src/kikoe/providers/local/connection.py:101
msgid "The local engine returned an unreadable result."
msgstr "Локальный движок вернул нечитаемый результат."

#: src/kikoe/providers/local/connection.py:125
msgid ""
"The local engine could not start. Try another acceleration option in "
"Preferences, or download the engine again."
msgstr ""
"Не удалось запустить локальный движок. Попробуйте другой вариант ускорения в "
"настройках или загрузите движок заново."

#: src/kikoe/providers/local/connection.py:133
msgid ""
"The model could not be loaded. It may need more memory than is free, or the "
"file is damaged; download it again or choose a smaller model."
msgstr ""
"Не удалось загрузить модель. Возможно, ей требуется больше памяти, чем "
"доступно, или файл повреждён; загрузите её заново или выберите модель "
"поменьше."

#: src/kikoe/providers/local/connection.py:139
msgid "The selected device failed. Choose another device in Preferences."
msgstr ""
"Выбранное устройство дало сбой. Выберите другое устройство в настройках."

#: src/kikoe/providers/local/connection.py:142
msgid "The local model could not process this audio."
msgstr "Локальная модель не смогла обработать это аудио."

#: src/kikoe/providers/local/connection.py:144
msgid "Transcription was cancelled."
msgstr "Расшифровка была отменена."

#: src/kikoe/providers/local/connection.py:146
msgid "The local engine failed. See the log for details."
msgstr "Локальный движок дал сбой. Подробности смотрите в журнале."

#: src/kikoe/providers/mistral_file_stream.py:61
#: src/kikoe/providers/openai_file_stream.py:66
msgid "Transcription ended before it was complete. Try again."
msgstr "Расшифровка прервана до завершения. Повторите попытку."

#: src/kikoe/providers/mistral_realtime.py:114
#, python-brace-format
msgid "Mistral rejected realtime transcription: {message}"
msgstr "Mistral отклонил расшифровку в реальном времени: {message}"

#: src/kikoe/providers/openai.py:165
#, python-brace-format
msgid "{host} rejected the realtime session: {message}"
msgstr "{host} отклонил сеанс в реальном времени: {message}"

#: src/kikoe/providers/openai.py:180
#, python-brace-format
msgid ""
"{host} does not support transcription while recording. Turn off “Transcribe "
"While Recording” for this model in Preferences."
msgstr ""
"{host} не поддерживает расшифровку во время записи. Отключите "
"“Расшифровывать во время записи” для этой модели в настройках."

#: src/kikoe/providers/openai.py:242
msgid "Realtime transcription failed. Your audio has been kept."
msgstr "Ошибка расшифровки в реальном времени. Аудио сохранено."

#: src/kikoe/services/file_transcription.py:120
msgid "Choose a file transcription model to retry this recording."
msgstr ""
"Выберите модель расшифровки файлов для повторной обработки этой записи."

#: src/kikoe/services/importer.py:74 src/kikoe/ui/bottom_bar.py:187
msgid "Choose a file transcription model to import audio."
msgstr "Выберите модель расшифровки файлов для импорта аудио."

#: src/kikoe/services/importer.py:258
msgid "The chunk size is too small for this audio format."
msgstr "Размер фрагмента слишком мал для этого формата аудио."

#: src/kikoe/services/local_models.py:111
msgid "Download the local engine in Preferences to use this model."
msgstr ""
"Загрузите локальный движок в настройках, чтобы использовать эту модель."

#: src/kikoe/services/local_models.py:186
msgid "On This Device"
msgstr "На этом устройстве"

#: src/kikoe/storage/audio_files.py:33
#, python-brace-format
msgid "Could not copy the audio file into the library: {error}"
msgstr "Не удалось скопировать аудиофайл в библиотеку: {error}"

#: src/kikoe/storage/captures.py:142
msgid "Could not read the saved transcript. Its audio has been kept."
msgstr "Не удалось прочитать сохранённую расшифровку. Аудио сохранено."

#: src/kikoe/storage/captures.py:167
#, python-brace-format
msgid "Could not read a saved recording. Its audio has been kept. ({detail})"
msgstr "Не удалось прочитать сохранённую запись. Аудио сохранено. ({detail})"

#: src/kikoe/storage/captures.py:231
#, python-brace-format
msgid "Could not save the recording. ({detail})"
msgstr "Не удалось сохранить запись. ({detail})"

#: src/kikoe/storage/downloads.py:46 src/kikoe/storage/downloads.py:78
msgid "Downloads must use a secure connection."
msgstr "Загрузки должны использовать защищённое соединение."

#: src/kikoe/storage/downloads.py:62
#, python-brace-format
msgid "“{name}” did not match its expected checksum."
msgstr "«{name}» не совпала с ожидаемой контрольной суммой."

#: src/kikoe/storage/downloads.py:68
#, python-brace-format
msgid "Could not download “{name}”. Check your internet connection."
msgstr "Не удалось загрузить «{name}». Проверьте подключение к интернету."

#: src/kikoe/storage/downloads.py:82
#, python-brace-format
msgid "The download server answered with error {status}."
msgstr "Сервер загрузки ответил ошибкой {status}."

#: src/kikoe/storage/downloads.py:100
msgid "The downloaded file is larger than expected."
msgstr "Загруженный файл больше, чем ожидалось."

#: src/kikoe/storage/downloads.py:111
msgid "The download ended early. Try again."
msgstr "Загрузка завершилась преждевременно. Попробуйте снова."

#: src/kikoe/storage/library.py:67
msgid ""
"The note library was created by a newer version of Kikoe. Update Kikoe to "
"open it."
msgstr ""
"Библиотека заметок создана в более новой версии Kikoe. Обновите Kikoe, чтобы "
"открыть её."

#: src/kikoe/storage/library.py:182 src/kikoe/storage/library.py:302
#: src/kikoe/storage/library.py:323
msgid "This recording no longer exists."
msgstr "Эта запись больше не существует."

