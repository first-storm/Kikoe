msgstr ""
"Не удалось сохранить ключи API: безопасное хранилище учётных данных "
"недоступно. Подробности: {error}"

#: src/kikoe/storage/settings.py:64
#, python-brace-format
msgid "Could not read the settings file: {error}"
msgstr "Не удалось прочитать файл настроек: {error}"

#: src/kikoe/storage/settings.py:76
#, python-brace-format
msgid "The settings file {detail} is damaged or not understood: {error}"
msgstr "Файл настроек {detail} повреждён или не распознан: {error}"

#: src/kikoe/storage/settings.py:101
#, python-brace-format
msgid "Could not save the settings file: {error}"
msgstr "Не удалось сохранить файл настроек: {error}"

